.kubernetes-manifests-*/
.project
.skaffold-*.yaml
.claude.md
.venv/
.vs/
.vscode/
*.iml
*.ipr
*.iws
*.pyc
*.swp
*~
bin/
build/
Dockerfile.pip
node_modules/
obj/
pkg/
release/wi-kubernetes-manifests.yaml
vendor/

# =============================================================================
# Terraform
# =============================================================================
# Provider binaries — hundreds of MB, re-downloadable with `terraform init`.
.terraform/
**/.terraform/*

# State. Contains every attribute of every resource, including values that
# behave like secrets. Lives in s3://ilias-mgp-tfstate instead.
*.tfstate
*.tfstate.*
crash.log

# Variable values — admin_cidr is a home IP address.
# terraform.tfvars.example is NOT matched by this and stays tracked.
*.tfvars

# Saved plan files (terraform plan -out=...). Contain resolved values.
*.tfplan

# NOTE: .terraform.lock.hcl is deliberately NOT ignored.
# It pins exact provider versions and their checksums, which is what makes
# your laptop, a teammate's machine and the CI runner resolve identical
# provider builds. It must be committed.

# =============================================================================
# Kubernetes / credentials
# =============================================================================
# kubeconfig files hold client-certificate-data and client-key-data — i.e.
# cluster-admin credentials. Never commit one.
kubeconfig
kubeconfig*.yaml
kubeconfig*.yml
*.kubeconfig

# Keys and certificates
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# =============================================================================
# Credentials — never in the repo
# =============================================================================
# AWS keys belong in ~/.aws/credentials (via `aws configure`), nowhere else.
terraform user.txt
*credential*
*credentials*
*secret*
accessKeys.csv
new_user_credentials.csv

# Local environment files
.env
.env.*
!.env.example
