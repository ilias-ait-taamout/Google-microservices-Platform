# =============================================================================
#  MODÈLE DE CONFIGURATION
#
#  1. Copier ce fichier :   cp .env.example .env
#  2. Remplacer REPLACE_ME_... par les vraies valeurs
#  3. NE JAMAIS COMMITER .env  (déjà présent dans .gitignore)
#
#  Pourquoi ce fichier existe : la clé ne doit jamais apparaître dans le code
#  ni dans l'historique Git. Gitleaks tourne en pre-commit et en CI pour le
#  garantir. En cluster, la même variable est résolue par External Secrets
#  depuis AWS Secrets Manager — le code Python ne change pas, il lit toujours
#  os.environ.
# =============================================================================

# Clé API Anthropic — à créer sur console.anthropic.com > API Keys
# Format attendu : sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=REPLACE_ME_AVEC_TA_CLE_ANTHROPIC

# (optionnel) Chemin vers un kubeconfig spécifique.
# Si absent, le client utilise ~/.kube/config et le contexte courant.
# KUBECONFIG=REPLACE_ME_CHEMIN_VERS_KUBECONFIG

# (optionnel) Contexte kubectl à cibler, utile si tu as plusieurs clusters.
# KUBE_CONTEXT=kind-audit-demo
